#!/bin/sh
## Description: Pull the image and roll out (run on the server by release)
# The targets' release and rollback remote step (config.yaml), run on the
# server by `devopsy @<target> --release` and `--rollback`.
set -eu
devopsy pull --quiet
devopsy up -d --wait --remove-orphans
echo "deploy: ${SITE_URL:-no URL: no wildcard domain or DEVOPSY_DOMAINS}" >&2
